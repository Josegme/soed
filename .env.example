# =============================================================================
# SOED · variables de entorno (copiar a .env.local para desarrollo).
# Los valores reales viven SOLO en Vercel (por entorno) y en .env.local.
# Nunca en el repositorio ni en el chat (CLAUDE.md).
# =============================================================================

# Instancia de cliente a construir: carpeta de clients/ (por defecto _template).
SOED_CLIENT=encuentro-danzas

# URL pública del sitio (links en emails, QR y callbacks de auth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API. La clave publicable (sb_publishable_…)
# es pública por diseño: RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Clave secreta (sb_secret_… o service_role legacy). SOLO servidor: columnas
# derivadas, liquidaciones y colas. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Email (ADR-0013). EMAIL_MODO=sink en desarrollo y preview: no envía a
# terceros y deja el email en la tabla email_envio con estado SIMULADO.
# Solo producción con EMAIL_MODO=resend envía de verdad.
EMAIL_MODO=sink
RESEND_API_KEY=re_xxx

# Vercel Cron (cola de emails cada 5 min y recordatorios diarios). Vercel envía
# "Authorization: Bearer <CRON_SECRET>"; sin esta variable los crons responden 401.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Solo CI / scripts locales
# SUPABASE_DB_URL_ENCUENTRO_DANZAS=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
